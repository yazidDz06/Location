
#  Copiez ce fichier vers .env puis remplissez les valeurs.
#  Générez vos secrets avec :
#  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"


NODE_ENV=development
PORT=5000
DB_URL=mongodb://127.0.0.1:27017/location

# Origines autorisées par CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173

# Secrets cryptographiques (32 octets minimum, base64url)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_PEPPER=
CSRF_SECRET=

# Durées de vie des jetons
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Verrouillage de compte après échecs de connexion
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15

# Redis (optionnel — bascule sur un store mémoire si absent)
REDIS_URL=
